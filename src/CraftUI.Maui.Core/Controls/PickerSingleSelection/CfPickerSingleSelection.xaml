<?xml version="1.0" encoding="utf-8"?>

<inputTextLayout:InputTextLayout 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputTextLayout="clr-namespace:CraftUI.Maui.Controls.InputTextLayout"
    x:Class="CraftUI.Maui.Controls.PickerSingleSelection.CfPickerSingleSelection">
    
    <inputTextLayout:InputTextLayout.Resources>
        <Style x:Key="LabelLabel" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource Gray950}" />
            <Setter Property="VerticalOptions" Value="CenterAndExpand" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="HorizontalOptions" Value="StartAndExpand" />
            <Setter Property="MinimumHeightRequest" Value="40" />
        </Style>
    </inputTextLayout:InputTextLayout.Resources>
    
    <inputTextLayout:InputTextLayout.View>
        <Label 
            Style="{StaticResource LabelLabel}" 
            x:Name="Element" />
    </inputTextLayout:InputTextLayout.View>
    
</inputTextLayout:InputTextLayout>